name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ==========================================================================
  # Backend: Node 24, Prisma validate, typecheck, vitest
  # ==========================================================================
  backend:
    name: backend (typecheck + tests)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: kora
          POSTGRES_PASSWORD: kora
          POSTGRES_DB: kora
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U kora -d kora"
          --health-interval 5s --health-timeout 3s --health-retries 10
      redis:
        image: redis:7-alpine
        ports: ["6379:6379"]
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s --health-timeout 3s --health-retries 10
    env:
      DATABASE_URL: postgresql://kora:kora@localhost:5432/kora
      REDIS_URL: redis://localhost:6379
      JWT_SECRET: ci-secret-ci-secret-ci-secret-ci
      APP_ENV: development
      STORAGE_DRIVER: s3
      S3_ENDPOINT: http://localhost:9000
      S3_BUCKET: kora-media
      SMS_PROVIDER: dev
      OTP_DEV_CODE: "123456"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: npm
          cache-dependency-path: backend/package-lock.json
      - name: Install dependencies
        run: npm ci
      - name: Prisma validate + generate
        run: |
          npx prisma validate
          npx prisma generate
      - name: Apply migrations (test DB)
        run: npx prisma migrate deploy
      - name: Typecheck
        run: npx tsc --noEmit
      - name: Tests
        run: npx vitest run

  # ==========================================================================
  # App: Flutter analyze + tests. Requires Flutter SDK — provided by
  # subosito/flutter-action on the runner (SDK is NOT needed on dev machines).
  # ==========================================================================
  app:
    name: app (analyze + test)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: app
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
      - name: Flutter version
        run: flutter --version
      - name: Pub get
        run: flutter pub get
      - name: Analyze
        run: flutter analyze
      - name: Tests
        run: flutter test

  # ==========================================================================
  # Security: secret scanning + dependency audit
  # ==========================================================================
  security:
    name: security (gitleaks + npm audit)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # gitleaks needs full history
      - name: Gitleaks (secret scan)
        uses: gitleaks/gitleaks-action@v2
      - name: npm audit (backend)
        working-directory: backend
        run: npm audit --audit-level=high
        continue-on-error: true # report-only until dependency baseline stabilizes

  # ==========================================================================
  # Infra smoke: docker-compose config + bring up + health checks
  # ==========================================================================
  infra-smoke:
    name: infra (docker-compose smoke)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate compose file
        run: docker compose -f infra/docker-compose.yml config --quiet
      - name: Start infra
        run: docker compose -f infra/docker-compose.yml up -d
      - name: Wait for health
        run: |
          timeout 120 bash -c 'until [ "$(docker inspect -f {{.State.Health.Status}} kora-postgres)" = "healthy" ]; do sleep 2; done'
          timeout 60  bash -c 'until [ "$(docker inspect -f {{.State.Health.Status}} kora-redis)" = "healthy" ]; do sleep 2; done'
          timeout 120 bash -c 'until [ "$(docker inspect -f {{.State.Health.Status}} kora-minio)" = "healthy" ]; do sleep 2; done'
      - name: Verify Postgres extensions + bucket
        run: |
          docker exec kora-postgres psql -U kora -d kora -tAc \
            "SELECT extname FROM pg_extension WHERE extname IN ('pg_trgm','unaccent','pgcrypto') ORDER BY 1" | tee extensions.txt
          grep -q pg_trgm extensions.txt && grep -q unaccent extensions.txt && grep -q pgcrypto extensions.txt
          docker exec kora-minio mc alias set local http://localhost:9000 kora koraminio
          docker exec kora-minio mc ls local/kora-media
      - name: Teardown
        if: always()
        run: docker compose -f infra/docker-compose.yml down -v
