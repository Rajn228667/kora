# =============================================================================
# KORA backend — environment template
# Copy to `backend/.env` and fill in values. NEVER commit a real `.env`.
# All secrets shown here are local-development placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
# Environment name: development | staging | production
APP_ENV=development

# HTTP bind settings
PORT=3000
HOST=0.0.0.0

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Datastores
# -----------------------------------------------------------------------------
# PostgreSQL 16 connection string (Prisma)
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora

# Redis 7 (sessions, OTP store, rate limits, pub/sub, cache)
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# REQUIRED: 32+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-32-chars-minimum-secret

# Access token lifetime (short-lived)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (rotated on each refresh, reuse detection enabled)
JWT_REFRESH_TTL=30d

# -----------------------------------------------------------------------------
# OTP / SMS
# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY: fixed OTP code accepted when SMS_PROVIDER=dev.
# Must be unset in staging/production.
OTP_DEV_CODE=123456

# SMS provider: dev | <provider-name>
SMS_PROVIDER=dev
SMS_API_KEY=
SMS_SENDER=KORA

# -----------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO in dev)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kora-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=kz

# -----------------------------------------------------------------------------
# Push notifications
# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Android)
FCM_SERVER_KEY=

# Apple Push Notification service (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=kz.kora.app

# -----------------------------------------------------------------------------
# Payments — Kaspi merchant integration
# Leave empty in development to use the mock provider.
# -----------------------------------------------------------------------------
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_BASE_URL=
# Secret used to verify webhook signatures on /v1/payments/webhook/kaspi
KASPI_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Maps
# -----------------------------------------------------------------------------
MAPS_PROVIDER=yandex
YANDEX_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# HTTP CORS
# Comma-separated list of allowed origins. Empty = same-origin only.
# Example: CORS_ORIGINS=https://admin.kora.kz,https://manager.kora.kz
# -----------------------------------------------------------------------------
CORS_ORIGINS=
