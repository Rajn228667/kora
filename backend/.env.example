# --- Core ---
APP_ENV=development            # development | staging | production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Datastores ---
# Production DB lives on Supabase (project ref: egjswwveeezjavpegjaf,
# region eu-central-1). Use the pooled connection string and set the
# project password from the Supabase dashboard (Database → Settings):
# postgresql://postgres.egjswwveeezjavpegjaf:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora?schema=public
REDIS_URL=redis://localhost:6379        # optional: unset to use in-process event bus

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=900               # seconds (15 min)
JWT_REFRESH_TTL=2592000          # seconds (30 days)

# --- OTP / SMS ---
SMS_PROVIDER=dev                 # dev | kazinfoteh | twilio ...
OTP_DEV_CODE=246810              # only used when SMS_PROVIDER=dev
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=10

# --- Storage (media) ---
STORAGE_DRIVER=local             # local | s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kora-media
S3_ACCESS_KEY=
S3_SECRET=
S3_PUBLIC_BASE_URL=http://localhost:9000/kora-media
S3_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_TTL_SECONDS=600
LOCAL_STORAGE_DIR=./var/uploads

# --- Push ---
PUSH_PROVIDER=noop               # noop | fcm | fcm+apns
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# --- Payments ---
PAYMENT_PROVIDER=mock            # mock | kaspi
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=
KASPI_BASE_URL=
PAYMENT_PENDING_TIMEOUT_MINUTES=15

# --- Maps ---
MAPS_PROVIDER=2gis               # 2gis | google | none
MAPS_API_KEY=

# --- HTTP security ---
CORS_ORIGINS=http://localhost:3000 # comma-separated explicit allowlist
RATE_LIMIT_MAX=300               # per minute, global
RATE_LIMIT_AUTH_MAX=20           # per minute on /v1/auth/*

# --- Jobs ---
COURIER_LOCATION_RETENTION_DAYS=30
DISPATCH_OFFER_TIMEOUT_SECONDS=30
ORDER_STALE_TIMEOUT_MINUTES=120
